{
  "openapi": "3.0.3",
  "info": {
    "title": "Inventory Management System API",
    "description": "API documentation for the Inventory Management System",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://inventory-management-with-auth-and-role.onrender.com"
    },
    {
      "url": "http://localhost:3000"
    }
  ],
  "components": {
    "schemas": {
      "Category": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "Supplier": {
        "type": "object",
        "required": [
          "name",
          "phone"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 40
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "maxLength": 11
          },
          "address": {
            "type": "string",
            "maxLength": 60
          },
          "contactPerson": {
            "type": "string",
            "maxLength": 20
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "name",
          "sku",
          "price",
          "categoryId",
          "supplierId"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 40
          },
          "description": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "quantity": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "minimumStock": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "categoryId": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "supplierId": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          }
        }
      },
      "InventoryTransactionInput": {
        "type": "object",
        "required": [
          "productId",
          "type",
          "quantity"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "in",
              "out"
            ]
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "InventoryTransaction": {
        "allOf": [
          {
            "$ref": "#/components/schemas/InventoryTransactionInput"
          },
          {
            "type": "object",
            "required": [
              "_id",
              "userId",
              "previousQuantity",
              "newQuantity",
              "createdAt"
            ],
            "properties": {
              "_id": {
                "type": "string"
              },
              "userId": {
                "type": "string",
                "description": "GitHub account ID of the authenticated user"
              },
              "previousQuantity": {
                "type": "integer",
                "minimum": 0
              },
              "newQuantity": {
                "type": "integer",
                "minimum": 0
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "inventory.sid"
      }
    }
  },
  "tags": [
    {
      "name": "Authentication",
      "description": "GitHub OAuth authentication"
    },
    {
      "name": "Categories",
      "description": "Category management"
    },
    {
      "name": "Suppliers",
      "description": "Supplier management"
    },
    {
      "name": "Products",
      "description": "Product management"
    },
    {
      "name": "Transactions",
      "description": "Inventory stock transaction history"
    }
  ],
  "paths": {
    "/api/v1/auth/github": {
      "get": {
        "summary": "Start GitHub sign-in",
        "description": "OAuth sign-in redirects the browser to GitHub and cannot be completed with Swagger's Try it out (which uses fetch). Open [GitHub sign-in in this browser](../api/v1/auth/github) instead.",
        "tags": [
          "Authentication"
        ],
        "responses": {
          "302": {
            "description": "Redirects to GitHub authorization"
          },
          "400": {
            "description": "OAuth must be started by browser navigation, not by a fetch request"
          }
        }
      }
    },
    "/api/v1/auth/github/callback": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "responses": {
          "302": {
            "description": "Sets the authentication cookie and redirects to the home page"
          },
          "401": {
            "description": "GitHub authentication failed"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "description": "Logout successful; authentication cookie cleared"
          }
        }
      }
    },
    "/api/v1/categories": {
      "get": {
        "tags": [
          "Categories"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "description",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Categories retrieved successfully"
          }
        }
      },
      "post": {
        "tags": [
          "Categories"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Category"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Category created successfully"
          }
        }
      }
    },
    "/api/v1/categories/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "tags": [
          "Categories"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Category retrieved successfully"
          }
        }
      },
      "put": {
        "tags": [
          "Categories"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Category"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Category updated successfully"
          }
        }
      },
      "delete": {
        "tags": [
          "Categories"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "204": {
            "description": "Category deleted successfully"
          }
        }
      }
    },
    "/api/v1/suppliers": {
      "get": {
        "tags": [
          "Suppliers"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "contactPerson",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "phone",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "supplierId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Suppliers retrieved successfully"
          }
        }
      },
      "post": {
        "tags": [
          "Suppliers"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Supplier"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Supplier created successfully"
          }
        }
      }
    },
    "/api/v1/suppliers/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "tags": [
          "Suppliers"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Supplier retrieved successfully"
          }
        }
      },
      "put": {
        "tags": [
          "Suppliers"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Supplier"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supplier updated successfully"
          }
        }
      },
      "delete": {
        "tags": [
          "Suppliers"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "204": {
            "description": "Supplier deleted successfully"
          }
        }
      }
    },
    "/api/v1/products": {
      "get": {
        "tags": [
          "Products"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "description",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sku",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "quantity",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "minimumStock",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "categoryId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "supplierId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "productId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Products retrieved successfully"
          }
        }
      },
      "post": {
        "tags": [
          "Products"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Product"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Product created successfully"
          }
        }
      }
    },
    "/api/v1/products/low-stock": {
      "get": {
        "tags": [
          "Products"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Products at or below their minimum stock level"
          }
        }
      }
    },
    "/api/v1/products/supplier/{supplierId}": {
      "get": {
        "tags": [
          "Products"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "supplierId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Products supplied by the specified supplier"
          }
        }
      }
    },
    "/api/v1/products/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "tags": [
          "Products"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Product retrieved successfully"
          }
        }
      },
      "put": {
        "tags": [
          "Products"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Product"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Product updated successfully"
          }
        }
      },
      "delete": {
        "tags": [
          "Products"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "204": {
            "description": "Product deleted successfully"
          }
        }
      }
    },
    "/api/v1/products/category/{categoryId}": {
      "get": {
        "tags": [
          "Products"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "categoryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Products in the category retrieved successfully"
          }
        }
      }
    },
    "/api/v1/transactions": {
        "get": {
          "tags": [
            "Transactions"
          ],
          "security": [
            {
              "sessionCookie": []
            }
          ],
          "responses": {
            "200": {
              "description": "Transactions retrieved successfully"
            }
          }
        },
        "post": {
          "tags": [
            "Transactions"
          ],
          "security": [
            {
              "sessionCookie": []
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryTransactionInput"
                }
              }
            }
          },
          "responses": {
            "201": {
              "description": "Transaction created and product stock updated"
            },
            "400": {
              "description": "Invalid transaction input"
            },
            "404": {
              "description": "Product not found"
            },
            "409": {
              "description": "Insufficient stock"
            }
          }
        }
      },
      "/api/v1/transactions/product/{productId}": {
        "get": {
          "tags": [
            "Transactions"
          ],
          "security": [
            {
              "sessionCookie": []
            }
          ],
          "parameters": [
            {
              "name": "productId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{24}$"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Transactions for the product retrieved successfully"
            }
          }
        }
      },
      "/api/v1/transactions/{transactionId}": {
        "parameters": [
          {
            "name": "transactionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          }
        ],
        "get": {
          "tags": [
            "Transactions"
          ],
          "security": [
            {
              "sessionCookie": []
            }
          ],
          "responses": {
            "200": {
              "description": "Transaction retrieved successfully"
            },
            "404": {
              "description": "Transaction not found"
            }
          }
        },
        "delete": {
          "tags": [
            "Transactions"
          ],
          "security": [
            {
              "sessionCookie": []
            }
          ],
          "responses": {
            "200": {
              "description": "Transaction deleted and stock movement reversed"
            },
            "404": {
              "description": "Transaction not found"
            },
            "409": {
              "description": "Transaction cannot be safely reversed"
            }
        }
      }
    }
  }
}