  "components": {
    "schemas": {
      "UserRegistration": {
        "type": "object",
        "required": [
          "firstName",
          "lastName",
          "email",
          "phone",
          "role",
          "password"
        ],
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "maxLength": 11
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "user",
              "manager"
            ]
          },
          "password": {
            "type": "string",
            "minLength": 6
          }
        }
      },
      "UserLogin": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "UserUpdate": {
        "type": "object",
        "required": [
          "firstName",
          "lastName",
          "email",
          "phone",
          "role"
        ],
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "maxLength": 11
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "user",
              "manager"
            ]
          }
        }
      },
      "Category": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "Supplier": {
        "type": "object",
        "required": [
          "name",
          "phone"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 40
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "maxLength": 11
          },
          "address": {
            "type": "string",
            "maxLength": 60
          },
          "contactPerson": {
            "type": "string",
            "maxLength": 20
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "name",
          "sku",
          "price",
          "categoryId",
          "supplierId"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 40
          },
          "description": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "quantity": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "minimumStock": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "categoryId": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "supplierId": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
